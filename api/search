:4,"2939":4,"2940":4,"2941":4,"2942":4,"2943":4,"2944":4,"2945":4,"2946":4,"2947":4,"2948":4,"2949":4,"2950":4,"2951":5,"2952":5,"2953":5,"2954":5,"2955":5,"2956":5,"2957":5,"2958":5,"2959":5,"2960":5,"2961":4,"2962":4,"2963":4,"2964":4,"2965":4,"2966":4,"2967":4,"2968":4,"2969":4,"2970":5,"2971":5,"2972":5,"2973":5,"2974":5,"2975":5,"2976":5,"2977":5,"2978":5,"2979":5,"2980":5,"2981":5,"2982":5,"2983":5,"2984":5,"2985":5,"2986":5,"2987":5,"2988":5,"2989":5,"2990":5,"2991":5,"2992":5,"2993":5,"2994":5,"2995":5,"2996":5,"2997":5,"2998":5,"2999":5}}},"docs":{"docs":{"1":{"id":"/docs/design","page_id":"/docs/design","type":"page","content":"Design","breadcrumbs":["Pothos Docs"],"tags":[],"url":"/docs/design"},"2":{"id":"/docs/design-0","page_id":"/docs/design","tags":[],"type":"text","url":"/docs/design","content":"Design overview for Pothos"},"3":{"id":"/docs/design-1","page_id":"/docs/design","type":"heading","tags":[],"url":"/docs/design#type-system","content":"Type System"},"4":{"id":"/docs/design-2","page_id":"/docs/design","tags":[],"type":"text","url":"/docs/design#type-system","content":"The type system that powers most of the Pothos type checking has 2 components. The first is the\nSchemaTypes type param passed into the SchemaBuilder. This allows a shared set of types to be reused\nthroughout the schema, and is responsible for providing type information for shared types like the\nContext object, and any Object, Interface, or Scalar types that you want to\nreference by name (as a string). Having all type information in a single object can be convenient\nat times, but with large schemas, can become unwieldy."},"5":{"id":"/docs/design-3","page_id":"/docs/design","tags":[],"type":"text","url":"/docs/design#type-system","content":"To support a number of additional use cases, including Unions and Enums, large schemas, and plugins\nthat extract type information from other sources (eg the Prisma, or the simple-objects\nplugin), Pothos has another way of passing around type information. This system uses `Ref`\nobjects whose TypeScript types carry the backing shapes they represent. Every builder method for creating a type or\na field returns a `Ref` object."},"6":{"id":"/docs/design-4","page_id":"/docs/design","tags":[],"type":"text","url":"/docs/design#type-system","content":"Using Ref objects allows us to separate the type information from the implementation, and allows for\na more modular design. For example, `builder.objectRef<{ id: string }>('User')` declares\nthe backing shape before fields are defined with `implement`. The ref carries that shape at compile\ntime and identifies the GraphQL type at runtime; it does not validate resolver values at runtime.\nSee Objects and Circular References for examples."},"7":{"id":"/docs","page_id":"/docs","type":"page","content":"Getting started","breadcrumbs":["Pothos Docs"],"tags":[],"url":"/docs"},"8":{"id":"/docs-0","page_id":"/docs","tags":[],"type":"text","url":"/docs","content":"Install Pothos, build a schema, and run your first GraphQL query."},"9":{"id":"/docs-1","page_id":"/docs","type":"heading","tags":[],"url":"/docs#installing","content":"Installing"},"10":{"id":"/docs-2","page_id":"/docs","type":"heading","tags":[],"url":"/docs#set-up-typescript","content":"Set up TypeScript"},"11":{"id":"/docs-3","page_id":"/docs","type":"heading","tags":[],"url":"/docs#create-a-simple-schema","content":"Create a simple schema"},"12":{"id":"/docs-4","page_id":"/docs","type":"heading","tags":[],"url":"/docs#create-a-server","content":"Create a server"},"13":{"id":"/docs-5","page_id":"/docs","type":"heading","tags":[],"url":"/docs#run-a-query","content":"Run a query"},"14":{"id":"/docs-6","page_id":"/docs","type":"heading","tags":[],"url":"/docs#continue-building","content":"Continue building"},"15":{"id":"/docs-7","page_id":"/docs","tags":[],"type":"text","url":"/docs","content":"Define your GraphQL types, fields, and resolvers in TypeScript. Pothos checks how they fit together\nwithout generating resolver types or maintaining a separate schema definition."},"16":{"id":"/docs-8","page_id":"/docs","tags":[],"type":"text","url":"/docs","content":"This guide creates a small schema, serves it with\nGraphQL Yoga, and runs a query against it."},"17":{"id":"/docs-9","page_id":"/docs","tags":[],"type":"text","url":"/docs","content":"You can try the schema immediately with its Playground action below. Follow the setup steps to run\nthe same schema in your own server. Using the playground explains the editor controls."},"18":{"id":"/docs-10","page_id":"/docs","tags":[],"type":"text","url":"/docs#installing","content":"Start in an empty directory with Node.js and npm installed:"},"19":{"id":"/docs-11","page_id":"/docs","tags":[],"type":"text","url":"/docs#installing","content":"Install Pothos, its `graphql` peer dependency, and Yoga:"},"20":{"id":"/docs-12","page_id":"/docs","tags":[],"type":"text","url":"/docs#installing","content":"Install TypeScript and `tsx` to check and run the example:"},"21":{"id":"/docs-13","page_id":"/docs","tags":[],"type":"text","url":"/docs#set-up-typescript","content":"Create `tsconfig.json`:"},"22":{"id":"/docs-14","page_id":"/docs","tags":[],"type":"text","url":"/docs#set-up-typescript","content":"Pothos relies on strict null checking for its type inference. Keep `strict` enabled when adding\nPothos to an existing project too."},"23":{"id":"/docs-15","page_id":"/docs","tags":[],"type":"text","url":"/docs#create-a-simple-schema","content":"Create `schema.ts`:"},"24":{"id":"/docs-16","page_id":"/docs","tags":[],"type":"text","url":"/docs#create-a-simple-schema","content":"`queryType` defines the fields clients can query. Here, `hello` returns a string and accepts an\noptional `name` argument. Pothos infers the resolver's argument types from that definition."},"25":{"id":"/docs-17","page_id":"/docs","tags":[],"type":"text","url":"/docs#create-a-simple-schema","content":"`toSchema()` builds a graphql-js `GraphQLSchema`. You can use it with Yoga or another server that\naccepts a `GraphQLSchema`."},"26":{"id":"/docs-18","page_id":"/docs","tags":[],"type":"text","url":"/docs#create-a-server","content":"Create `server.ts` alongside `schema.ts`:"},"27":{"id":"/docs-19","page_id":"/docs","tags":[],"type":"text","url":"/docs#create-a-server","content":"Check the types, then start the server:"},"28":{"id":"/docs-20","page_id":"/docs","tags":[],"type":"text","url":"/docs#create-a-server","content":"`tsx` runs TypeScript without checking types, so run `tsc` separately to catch type errors."},"29":{"id":"/docs-21","page_id":"/docs","tags":[],"type":"text","url":"/docs#run-a-query","content":"Open http\\://localhost:4000/graphql to use Yoga's GraphiQL explorer.\nRun this query:"},"30":{"id":"/docs-22","page_id":"/docs","tags":[],"type":"text","url":"/docs#run-a-query","content":"The response is:"},"31":{"id":"/docs-23","page_id":"/docs","tags":[],"type":"text","url":"/docs#run-a-query","content":"Omit the `name` argument to get `\"hello, World\"`. Stop the server with Ctrl+C when you're done."},"32":{"id":"/docs-24","page_id":"/docs","tags":[],"type":"text","url":"/docs#continue-building","content":"Objects shows how to expose your application's data. Fields covers\nresolvers, lists, and nullability, and Arguments explains how clients pass values to them.\nWhen your schema needs request data, see Context. App layout shows how\nto organize a larger schema across files."},"33":{"id":"/docs/llms","page_id":"/docs/llms","type":"page","content":"LLM Integration","breadcrumbs":["Pothos Docs"],"tags":[],"url":"/docs/llms"},"34":{"id":"/docs/llms-0","page_id":"/docs/llms","tags":[],"type":"text","url":"/docs/llms","content":"Read the Pothos documentation as plain text for use with LLMs and other tools."},"35":{"id":"/docs/llms-1","page_id":"/docs/llms","type":"heading","tags":[],"url":"/docs/llms#documentation-index","content":"Documentation index"},"36":{"id":"/docs/llms-2","page_id":"/docs/llms","type":"heading","