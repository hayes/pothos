{
  "name": "@pothos/website",
  "private": true,
  "scripts": {
    "codegen": "pnpm run bundle-types && pnpm run build-examples",
    "dev": "pnpm run codegen && next dev --webpack",
    "build": "pnpm run codegen && pnpm run check-playground-refs && pnpm run type:only",
    "next-build": "next build",
    "build-ci": "pnpm turbo run build && pnpm run codegen && pnpm run check-playground-refs && pnpm run type:only && next build",
    "start": "next start",
    "bundle-types": "tsx scripts/bundle-types.ts",
    "build-examples": "tsx scripts/build-playground-examples.ts",
    "check-playground-refs": "tsx scripts/check-playground-references.ts",
    "type": "pnpm run codegen && tsc --noEmit",
    "type:only": "tsc --noEmit",
    "test": "pnpm run codegen && pnpm run test:examples && pnpm run test:unit",
    "test:examples": "pnpm run build-examples && pnpm run type:examples",
    "test:unit": "vitest run",
    "postinstall": "fumadocs-mdx",
    "check:examples": "node scripts/check-doc-examples.mjs",
    "check:links": "node scripts/check-doc-links.mjs",
    "check:formats": "node scripts/check-doc-formats.mjs",
    "type:examples": "node scripts/type-playground-examples.mjs",
    "check:playground": "node scripts/check-playground.mjs",
    "test:browser": "node scripts/run-playground-tests.mjs",
    "check:local": "node scripts/check-local-examples.mjs"
  },
  "engines": {
    "pnpm": ">=9.0.0"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@pothos/core": "workspace:^",
    "@pothos/plugin-add-graphql": "workspace:^",
    "@pothos/plugin-complexity": "workspace:^",
    "@pothos/plugin-dataloader": "workspace:^",
    "@pothos/plugin-directives": "workspace:^",
    "@pothos/plugin-drizzle": "workspace:^",
    "@pothos/plugin-errors": "workspace:^",
    "@pothos/plugin-mocks": "workspace:^",
    "@pothos/plugin-relay": "workspace:^",
    "@pothos/plugin-scope-auth": "workspace:^",
    "@pothos/plugin-simple-objects": "workspace:^",
    "@pothos/plugin-sub-graph": "workspace:^",
    "@pothos/plugin-tracing": "workspace:^",
    "@pothos/plugin-validation": "workspace:^",
    "@pothos/plugin-with-input": "workspace:^",
    "@pothos/plugin-zod": "workspace:^",
    "@tailwindcss/postcss": "^4.2.2",
    "@typescript/ata": "^0.9.8",
    "@vercel/analytics": "^1.6.1",
    "class-variance-authority": "^0.7.1",
    "dataloader": "^2.2.3",
    "drizzle-orm": "1.0.0-rc.2",
    "esbuild-wasm": "^0.27.1",
    "fumadocs-core": "16.7.15",
    "fumadocs-docgen": "^3.0.10",
    "fumadocs-mdx": "14.2.14",
    "fumadocs-ui": "16.7.15",
    "graphql": "^16.13.2",
    "graphql-language-service": "^5.5.0",
    "graphql-scalars": "^1.25.0",
    "lucide-react": "^1.8.0",
    "lz-string": "^1.5.0",
    "next": "^16.2.3",
    "next-themes": "^0.4.6",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-rehype": "^11.1.2",
    "sql.js": "1.14.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/lz-string": "^1.5.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/sql.js": "^1.4.11",
    "glob": "^13.0.0",
    "playwright": "^1.63.0",
    "postcss": "^8.5.9",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "unist-util-visit": "^5.0.0",
    "vitest": "^4.1.4"
  }
}
