// use prisma-8

model User {
  id         String    @id
  email      String    @unique
  tasks      Task[]
  reviews    Bug[]
  championed Feature[]

  @@map("user")
}

model Task {
  id      String @id
  title   String
  type    String
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])
  notes   Note[]

  @@discriminator(type)
  @@map("task")
}

model Note {
  id          String   @id
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id])
  featureCode String?
  feature     Feature? @relation(fields: [featureCode], references: [code])

  @@map("note")
}

model Bug {
  severity   String
  reviewerId String?
  reviewer   User?   @relation(fields: [reviewerId], references: [id])

  @@base(Task, "bug")
}

model Feature {
  priority     Int
  code         String  @unique
  championId   String?
  champion     User?   @relation(fields: [championId], references: [id])
  featureNotes Note[]

  @@base(Task, "feature")
  @@map("feature")
}
