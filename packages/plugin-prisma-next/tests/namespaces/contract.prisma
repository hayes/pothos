// use prisma-8

namespace nsa {
  model User {
    id    Int    @id
    orgId Int
    posts Post[]

    @@map("user")
  }

  model Post {
    id     Int    @id
    title  String
    userId Int
    user   User   @relation(fields: [userId], references: [id])

    @@map("post")
  }
}

namespace nsb {
  model User {
    id   String @id
    name String

    @@map("user")
  }
}
