{
  "name": "@pothos/plugin-prisma-next",
  "version": "0.0.0",
  "private": true,
  "description": "Pothos integration for the Prisma ORM 8 SQL collection client",
  "main": "./lib/index.js",
  "types": "./dts/index.d.ts",
  "module": "./esm/index.js",
  "exports": {
    "import": {
      "default": "./esm/index.js"
    },
    "require": {
      "types": "./dts/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "scripts": {
    "type": "tsc --project tsconfig.type.json && tsc --project tsconfig.scope-auth.json",
    "build": "pnpm build:clean && pnpm build:cjs && pnpm build:dts && pnpm build:esm",
    "build:clean": "git clean -dfX esm lib",
    "build:cjs": "swc src -d lib --config-file ../../.swcrc -C module.type=commonjs --strip-leading-paths",
    "build:esm": "cp -r dts/* esm/ && swc src -d esm --config-file ../../.swcrc -C module.type=es6 --strip-leading-paths",
    "build:dts": "tsc",
    "test": "pnpm vitest --run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hayes/pothos.git",
    "directory": "packages/plugin-prisma-next"
  },
  "author": "Michael Hayes",
  "license": "ISC",
  "keywords": [
    "pothos",
    "graphql",
    "schema",
    "typescript",
    "prisma",
    "prisma-next",
    "plugin"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@pothos/selection-mapper": "workspace:*"
  },
  "peerDependencies": {
    "@pothos/core": "workspace:^",
    "@pothos/plugin-relay": "*",
    "@pothos/plugin-with-input": "*",
    "graphql": "^16.10.0 || ^17.0.0",
    "@prisma/orm-framework": "8.0.0-rc.9",
    "@prisma/orm-family-sql": "8.0.0-rc.9"
  },
  "peerDependenciesMeta": {
    "@pothos/plugin-relay": {
      "optional": true
    },
    "@pothos/plugin-with-input": {
      "optional": true
    }
  },
  "devDependencies": {
    "@pothos/core": "workspace:*",
    "@pothos/plugin-errors": "workspace:*",
    "@pothos/plugin-relay": "workspace:*",
    "@pothos/plugin-with-input": "workspace:*",
    "@pothos/test-utils": "workspace:*",
    "@prisma/orm-framework": "8.0.0-rc.9",
    "@prisma/orm-family-sql": "8.0.0-rc.9",
    "@prisma/orm-sqlite": "8.0.0-rc.9",
    "@prisma/orm-postgres": "8.0.0-rc.9",
    "pg": "8.22.0",
    "@types/pg": "8.20.4",
    "@js-temporal/polyfill": "^0.5.1",
    "@pothos/plugin-scope-auth": "workspace:*"
  },
  "engines": {
    "node": ">=24"
  }
}
