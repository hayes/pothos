{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "generate": {
      "dependsOn": ["^build"],
      "outputs": [
        "prisma/client/**",
        "prisma/generated.ts",
        "tests/client/**",
        "tests/generated.ts",
        "tests/prisma-types-from-client/client/**",
        "tests/prisma-types-from-client/generated.ts",
        "tests/examples/codegen/schema/prisma-inputs.ts",
        "tests/examples/*/schema.graphql",
        "schema.graphql",
        "graphql-env.d.ts"
      ]
    },
    "build": {
      "dependsOn": ["generate", "^build"],
      "outputs": ["dts/**", "lib/**", "esm/**", ".next"]
    },
    "type": {
      "dependsOn": ["generate", "^build"],
      "outputs": []
    },
    "type:compat": {
      "dependsOn": ["generate", "^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["generate", "^build"],
      "outputs": []
    }
  }
}
